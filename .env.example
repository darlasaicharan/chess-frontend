# NEONMATE CHESS — Frontend Environment Variables
# Copy this file to .env or .env.local to customize your backend endpoints

# Backend API base URL (no trailing slash)
# Production (Render):
VITE_API_URL=https://chess-backend-rmkb.onrender.com/api/v1
# Local development fallback:
# VITE_API_URL=http://localhost:8080/api/v1

# WebSocket endpoint
# Production (Render WSS):
VITE_WS_URL=wss://chess-backend-rmkb.onrender.com/ws
# Local development fallback:
# VITE_WS_URL=ws://localhost:8080/ws
